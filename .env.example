# Google Gemini API Key (Optional server-side AI features)
GEMINI_API_KEY=""

# Admin Device Authorization (Restricts admin to 3 designated hardware devices)
ADMIN_DEVICE_AUTH_SECRET=""
PAIRING_KEY_BOSS_PHONE=""
PAIRING_KEY_BOSS_LAPTOP=""
PAIRING_KEY_WORK_LAPTOP=""

# Application Host URL
APP_URL=""

# =============================================================================
# Firebase Configuration Variables (Vercel & Vite Deployment)
# Add these in Vercel Dashboard -> Settings -> Environment Variables
# =============================================================================

# Firebase Project ID (e.g. modern-cogency-hlcf1)
VITE_FIREBASE_PROJECT_ID=modern-cogency-hlcf1

# Firebase Web App ID (e.g. 1:984379765739:web:80ebc3f8202761cdd41fae)
VITE_FIREBASE_APP_ID=1:984379765739:web:80ebc3f8202761cdd41fae

# Firebase Web API Key
VITE_FIREBASE_API_KEY=AIzaSyCMVb1mP1pF8D8TDqC-Lpn6pP6asigTkyo

# Firebase Auth Domain (e.g. modern-cogency-hlcf1.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=modern-cogency-hlcf1.firebaseapp.com

# Firebase Storage Bucket (e.g. modern-cogency-hlcf1.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=modern-cogency-hlcf1.firebasestorage.app

# Firebase Cloud Messaging Sender ID (e.g. 984379765739)
VITE_FIREBASE_MESSAGING_SENDER_ID=984379765739

# Firebase Custom Firestore Database ID (Required for custom named database)
VITE_FIREBASE_DATABASE_ID=ai-studio-storemanagements-286dd381-5157-4d57-9e8b-67a93bd87287

# Firebase Analytics Measurement ID (Optional)
VITE_FIREBASE_MEASUREMENT_ID=
